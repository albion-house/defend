#!/usr/bin/env sh
set -eu

if [ "$#" -eq 0 ]; then
  echo "usage: dev/sandbox <command> [args...]" >&2
  exit 64
fi

if [ -z "${MISE_CACHE_DIR:-}" ]; then
  tmp_root="${TMPDIR:-/private/tmp}"
  export MISE_CACHE_DIR="${tmp_root%/}/defend-mise-cache-${USER:-agent}"
fi

mkdir -p "$MISE_CACHE_DIR"

if [ "${DEFEND_SANDBOX_KEEP_NO_COLOR:-0}" != "1" ]; then
  unset NO_COLOR
fi

if [ "${DEFEND_MISE_OFFLINE:-0}" = "1" ] && [ -z "${MISE_OFFLINE+x}" ]; then
  export MISE_OFFLINE=1
fi

exec "$@"
