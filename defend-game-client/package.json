{
  "name": "@albion-house/defend-game-client",
  "version": "0.1.0",
  "description": "the embeddable defend game client",
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:embed": "vite build --config vite.fixture.config.ts && playwright test",
    "check": "aube run lint && aube run test && aube run test:embed && aube run build"
  },
  "dependencies": {
    "phaser": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
