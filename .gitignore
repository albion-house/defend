# Local mise overrides and generated local lockfiles stay machine-specific.
mise.local.toml
mise.*.local.toml
mise.local.lock
mise.*.local.lock

# Local environment and editor state.
.env
.env.*
!.env.example
.DS_Store
.vscode/
.idea/

# Obsidian vault-local state. Shared app, core-plugin, and hotkey settings
# under defend-docs/.obsidian/ stay trackable.
defend-docs/.obsidian/workspace.json
defend-docs/.obsidian/workspace-mobile.json
defend-docs/.obsidian/appearance.json
defend-docs/.obsidian/graph.json
defend-docs/.obsidian/bookmarks.json
defend-docs/.obsidian/cache/
defend-docs/.obsidian/plugins/
defend-docs/.obsidian/themes/
defend-docs/.obsidian/snippets/
defend-docs/.trash/

# Web dependencies and build artifacts.
node_modules/
.astro/
dist/
fixture-dist/
coverage/
playwright-report/
test-results/

# Logs and transient outputs.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
